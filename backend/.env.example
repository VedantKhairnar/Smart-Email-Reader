# Smart Email Reader - Enterprise Backend Configuration

# =============================================================================
# API Configuration
# =============================================================================
# Google Gemini AI API Key (required)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Murf AI API Key (required) 
# Get from: https://app.murf.ai/
MURF_API_KEY=your_murf_api_key_here

# =============================================================================
# Server Configuration
# =============================================================================
# Server host and port
HOST=0.0.0.0
PORT=8000

# Development mode (enables debug features, auto-reload)
DEBUG=false

# =============================================================================
# Logging Configuration
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (relative to backend directory)
LOG_FILE=logs/app.log

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for CORS (comma-separated)
# Use * for development, specific domains for production
CORS_ORIGINS=http://localhost:3000,https://mail.google.com

# =============================================================================
# Rate Limiting (Future)
# =============================================================================
# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Environment
# =============================================================================
# Environment: development, production, testing
ENVIRONMENT=production