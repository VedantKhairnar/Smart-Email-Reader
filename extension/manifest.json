{
  "manifest_version": 3,
  "name": "AI Email Reader",
  "version": "1.0",
  "description": "AI-powered email summarization and text-to-speech",
  
  "permissions": [
    "activeTab"
  ],
  
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Email Reader Settings"
  }
}
